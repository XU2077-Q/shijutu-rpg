shader_type canvas_item;
// 立绘的软边。
//
// 【为什么需要它】
// 这十五张立绘是水彩，边缘太软，自动抠图抠不干净（会留一圈脏白边），
// 所以决定**保留宣纸底** —— 立绘就是一张画笺。这个决定是对的，
// 但第一版是硬边的：一张 400×600 的矩形，纸色比场景的纸色浅一档，
// 于是屏幕上明明白白贴着一个长方形，像一张没裱好的画。
//
// 所以这里把四条边淡出去。淡出之后，纸还在、人还在，
// 但「矩形」这个形状没有了 —— 画笺融进纸里。
//
// 【为什么淡出量按比例给】
// 立绘有 843×1280 的，也有 853×1280 的，位子上的框却是同一个 400×600。
// 写死像素的话，换一张尺寸不同的图，淡出量就跟着变。
// 按 UV 的比例给，跟贴图多大无关。
//
// 【fade 为什么不能太大】
// 淡出是**从边缘往内吃**的。人物若靠边站（比如侧身、或手伸到画外），
// 吃太多就会把肩膀、衣袖一起吃掉。0.06 换算到 400 px 宽是 24 px、
// 600 px 高是 36 px —— 刚好化掉纸边，够不到人。

uniform float fade_x : hint_range(0.0, 0.3) = 0.06;
uniform float fade_y : hint_range(0.0, 0.3) = 0.06;

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	// smoothstep 而不是线性：线性淡出会在纸的中间留一圈看得见的「灰环」，
	// smoothstep 的 S 形曲线从 0 到 1 过渡得更快，肉眼看不到边界。
	float a = smoothstep(0.0, fade_x, UV.x)
		* smoothstep(0.0, fade_x, 1.0 - UV.x)
		* smoothstep(0.0, fade_y, UV.y)
		* smoothstep(0.0, fade_y, 1.0 - UV.y);
	c.a *= a;
	COLOR = c;
}
