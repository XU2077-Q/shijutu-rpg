   {
    "bid": "x5:0",
    "t": "n",
    "x": "外滩这条路，正式的名字叫黄浦滩路，路牌是英文的。"
   },
   {
    "bid": "x5:1",
    "t": "n",
    "x": "从苏州河口到十六铺，一栋一栋的洋楼：江海关、汇丰银行、怡和洋行。"
   },
   {
    "bid": "x5:2",
    "t": "n",
    "x": "江海关的钟楼前年刚落成，大钟每半点钟敲一遍，声音压过满江的汽笛。"
   },
   {
    "bid": "x5:3",
    "t": "n",
    "x": "钟楼底下的马路，是公共租界——英国人起的头，后来成了各国公共的地方。"
   },
   {
    "bid": "x5:4",
    "t": "n",
    "x": "租界有自己的巡捕、自己的法庭、自己的马路和电灯。"
   },
   {
    "bid": "x5:5",
    "t": "n",
    "x": "华人在租界里犯事，归会审公廨，洋人坐在堂上；洋人犯事，中国的官府管不着。"
   },
   {
    "bid": "x5:6",
    "t": "n",
    "x": "上海人管进租界叫「到洋场去」。"
   },
   {
    "bid": "x5:7",
    "t": "n",
    "x": "洋场里地面平整，夜里路灯通明；洋场外面，是华界，是另一座城。"
   }
  ]
 },
