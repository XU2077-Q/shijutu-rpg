  "beats": [
   {
    "bid": "x1:0",
    "t": "n",
    "x": "那年的北京，消息分三等。"
   },
   {
    "bid": "x1:1",
    "t": "n",
    "x": "最快的是电报，铜线从天津一路架到崇文门里的电报分局，洋字码滴滴答答地响，官府的军情走这条路，一天能到。"
   },
   {
    "bid": "x1:2",
    "t": "n",
    "x": "其次是邸报，驿站马递，抄发了给各省官府看，慢则三五日。"
   },
   {
    "bid": "x1:3",
    "t": "n",
    "x": "最慢也最广的，是人的嘴——茶楼、会馆、粥棚、剃头挑子，一句闲话出门，半日传遍九城。"
   },
   {
    "bid": "x1:4",
    "t": "n",
    "x": "这一年春天，关于海上的坏消息，三种速度一齐来了：电报里是官话，邸报上是含糊，人嘴里的，才是真的。"
   },
   {
    "bid": "x1:5",
    "t": "n",
    "x": "举子们都住在宣武门外，俗称宣南。"
   },
   {
    "bid": "x1:6",
    "t": "n",
    "x": "各省的会馆一街一巷地排开：湖南会馆、浏阳会馆、新会会馆、南海会馆。"
   },
   {
    "bid": "x1:7",
    "t": "n",
    "x": "会馆是同乡凑钱置的产业，给进京赶考的读书人落脚，一年房钱不过几吊。"
   },
   {
    "bid": "x1:8",
    "t": "n",
    "x": "三年一会试，宣南的街面上就多出几千个读书人：长衫、书箱、一口各地的官话。"
   },
   {
    "bid": "x1:9",
    "t": "n",
    "x": "道光年间龚自珍在这里写「万马齐喑」，六十年过去，会馆还是那些会馆，长衫还是那些长衫。"
   }
  ]
 },
