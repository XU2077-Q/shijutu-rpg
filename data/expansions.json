  "beats": [
   {
    "bid": "x20:0",
    "t": "n",
    "x": "出彰化往南，第三天到斗六。"
   },
   {
    "bid": "x20:1",
    "t": "n",
    "x": "黎景高的第五封信，写的就是这里——「他们在斗六、大埤一带，见人就杀」「弟躲在甘蔗田里」「出来的时候，村子没了」。"
   },
   {
    "bid": "x20:2",
    "t": "n",
    "x": "信上的甘蔗田还在，蔗还在种。田边有一片荒地，草长得比人高。"
   },
   {
    "bid": "x20:3",
    "t": "n",
    "x": "同行引路的人说，那是旧村的地：村子在光绪二十二年六月没了，活下来的人在三里外另起了屋，新村用的还是旧名。"
   },
   {
    "bid": "x20:4",
    "t": "n",
    "x": "旧名底下，户数少了三成。他向人打听黎景高当年教的那几个孩子，问了三家，都说不知道去向。"
   },
   {
    "bid": "x20:5",
    "t": "n",
    "x": "新村口有个老人，六十多岁，姓陈。"
   },
   {
    "bid": "x20:6",
    "t": "n",
    "x": "他领沈怀瑾看祠堂的墙——下半截是新砖，上半截是熏黑的旧砖。"
   },
   {
    "bid": "x20:7",
    "t": "n",
    "x": "他说，那年六月，乡下人打了日本人的派出所，日本人就来了兵，挨庄地烧。"
   },
   {
    "bid": "x20:8",
    "t": "n",
    "x": "他掰着指头数庄名：大莆林、他里雾、土库、笨港……数到第九个，不数了。"
   },
   {
    "bid": "x20:9",
    "t": "n",
    "x": "有人说，烧了七十二庄。"
   },
   {
    "bid": "x20:10",
    "t": "n",
    "x": "死了多少人，两本账不一样：台湾人传的，是几万；日本人的册子上，只写「讨伐」两个字。"
   },
   {
    "bid": "x20:11",
    "t": "n",
    "x": "两本账，差着一道海峡。"
   },
   {
    "bid": "x20:12",
    "t": "n",
    "x": "沈怀瑾问：村里的人呢。老人说，跑得脱的跑了。跑不脱的，男人当场就……"
   },
   {
    "bid": "x20:13",
    "t": "n",
    "x": "他说到一半，不说了，蹲下去抽烟。过了很久，他说：村里如今有两个疯的。都是那年的女人。"
   },
   {
    "bid": "x20:14",
    "t": "n",
    "x": "一个见人就笑，一个见了刀就跪。村里没有人提这件事。提一回，疼一回。"
   },
   {
    "bid": "x20:15",
    "t": "n",
    "x": "旁边的妇人把话接了过去，只说了一句：先生，你是读书人，你们写下来吧。"
   },
   {
    "bid": "x20:16",
    "t": "n",
    "x": "写下来，她们受的罪才算有个数。"
   },
   {
    "bid": "x20:17",
    "t": "n",
    "x": "沈怀瑾在簿子上记了一行字：「云林。不可问，不可忘。」他想给这件事找一本书。"
   },
   {
    "bid": "x20:18",
    "t": "n",
    "x": "长沙的书他读过，台北的书他见不着；日本人的官报上，这一年写作「云林讨伐」，台湾人的册子上，写作「云林大屠」。"
   },
   {
    "bid": "x20:19",
    "t": "n",
    "x": "同一场事，两个名字。他又添了一行：「账有两本，字不一样。"
   },
   {
    "bid": "x20:20",
    "t": "n",
    "x": "」那一夜他宿在斗六的客栈里，把黎景高的第五封信取出来，就着灯，又读了一遍。"
   },
   {
    "bid": "x20:21",
    "t": "n",
    "x": "信纸下角那块褐色的印子，他对着灯看了很久。"
   }
  ]
 },
